From 62fa076827aaf9ffb7a62caa14252e017325232e Mon Sep 17 00:00:00 2001
From: lakitu <1219387824@qq.com>
Date: Mon, 31 Aug 2026 20:23:56 +0800
Subject: [PATCH] kumquat: KUMQUAT_GPU_SOCKET env override + abstract '@' unix
 names

Guest ICD: KUMQUAT_GPU_SOCKET overrides the hardcoded /tmp/kumquat-gpu-<n>
path so a host-side server (Android app domain) is reachable without
path gymnastics. magma-gpu-rs Tube::new/Listener::bind translate a leading
'@' into an abstract AF_UNIX name (netns-scoped: shared-netns containers
connect with zero bind-mounts and survive server restarts).
---
 .../platform/kumquat/VirtGpuKumquatDevice.cpp | 11 ++++++++-
 .../magma-gpu-rs/lib/util/sys/linux/tube.rs   | 23 +++++++++++++++++--
 2 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/src/gfxstream/guest/platform/kumquat/VirtGpuKumquatDevice.cpp b/src/gfxstream/guest/platform/kumquat/VirtGpuKumquatDevice.cpp
index 70d58d02531..fd08a9e9374 100644
--- a/src/gfxstream/guest/platform/kumquat/VirtGpuKumquatDevice.cpp
+++ b/src/gfxstream/guest/platform/kumquat/VirtGpuKumquatDevice.cpp
@@ -49,7 +49,16 @@ VirtGpuKumquatDevice::VirtGpuKumquatDevice(enum VirtGpuCapset capset, int32_t de
     processName = getprogname();
 #endif
 
-    if (descriptor >= 0) {
+    /* PATCH(nous-hermes): KUMQUAT_GPU_SOCKET overrides the hard-coded
+     * "/tmp/kumquat-gpu-<descriptor>" path so the guest can reach a server at
+     * an arbitrary location, e.g. one living in the Android host (app domain).
+     * A leading '@' selects an abstract AF_UNIX name (netns-scoped: needs a
+     * shared host netns, e.g. DroidSpaces net_mode=host, but survives server
+     * restarts with no stale bind-mount/inode). */
+    const char* envSocket = getenv("KUMQUAT_GPU_SOCKET");
+    if (envSocket && envSocket[0]) {
+        gpu_socket_path = envSocket;
+    } else if (descriptor >= 0) {
         gpu_socket_path.append(std::to_string(descriptor));
         mDescriptor = descriptor;
     } else {
diff --git a/src/virtio/magma-gpu-rs/lib/util/sys/linux/tube.rs b/src/virtio/magma-gpu-rs/lib/util/sys/linux/tube.rs
index ebc73ba44b6..cf685857504 100644
--- a/src/virtio/magma-gpu-rs/lib/util/sys/linux/tube.rs
+++ b/src/virtio/magma-gpu-rs/lib/util/sys/linux/tube.rs
@@ -7,6 +7,7 @@ use std::io::IoSlice;
 use std::io::IoSliceMut;
 use std::mem::MaybeUninit;
 use std::os::fd::AsFd;
+use std::os::unix::ffi::OsStrExt;
 use std::path::Path;
 
 use rustix::cmsg_space;
@@ -40,6 +41,24 @@ use crate::util::TubeType;
 
 const MAX_IDENTIFIERS: usize = 28;
 
+/* PATCH(nous-hermes): a leading '@' in a unix socket path selects the abstract
+ * namespace instead of a filesystem pathname (linux only). Applied on both the
+ * client (Tube::new) and server (Listener::bind) side, so "@kumquat-gpu-0"
+ * works symmetrically. */
+fn unix_addr_from_bytes(bytes: &[u8]) -> rustix::io::Result<SocketAddrUnix> {
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        if let Some(name) = bytes.strip_prefix(b"@") {
+            return SocketAddrUnix::new_abstract_name(name);
+        }
+    }
+    let path = {
+        use std::os::unix::ffi::OsStrExt;
+        std::path::Path::new(std::ffi::OsStr::from_bytes(bytes))
+    };
+    SocketAddrUnix::new(path)
+}
+
 pub struct Tube {
     socket: OwnedDescriptor,
 }
@@ -88,7 +107,7 @@ impl Tube {
             )?,
         };
 
-        let unix_addr = SocketAddrUnix::new(path)?;
+        let unix_addr = unix_addr_from_bytes(path.as_ref().as_os_str().as_bytes())?;
         connect(&socket, &unix_addr)?;
 
         Ok(Tube {
@@ -168,7 +187,7 @@ impl Listener {
             None,
         )?;
 
-        let unix_addr = SocketAddrUnix::new(path)?;
+        let unix_addr = unix_addr_from_bytes(path.as_ref().as_os_str().as_bytes())?;
         bind(&socket, &unix_addr)?;
         listen(&socket, 128)?;
 
-- 
